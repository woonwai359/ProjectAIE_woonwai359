generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Local mirror of a CSMJU2030 identity the moment it first touches this
/// subsystem. `username` is the shared identity key from the JWT
/// (`x-user-id`). Everything else here is local (layer2) data.
model UserProfile {
  id          String        @id @default(cuid())
  studentCode String        @unique
  fullName    String
  email       String?       @unique
  role        String        @default("student")
  faculty     String        @default("วิทยาศาสตร์")
  major       String        @default("วิทยาการคอมพิวเตอร์")
  createdAt   DateTime      @default(now())
  HourRequest HourRequest[]
}

model Activity {
  id                String          @id @default(cuid())
  title             String
  description       String?
  activityType      String
  date              DateTime
  startTime         DateTime
  endTime           DateTime
  location          String?
  capacity          Int
  hours             Int
  coOpEligible      Boolean         @default(true)
  registrationOpen  DateTime
  registrationClose DateTime
  status            ActivityStatus  @default(DRAFT)
  createdByUsername String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  Participation     Participation[]

  @@index([status])
  @@index([date])
}

/// Manual hour claim submitted by a student
/// (e.g. external volunteer work), reviewed by staff/admin.
model HourRequest {
  id               String      @id @default(cuid())
  userId           String
  title            String
  dateStr          String
  timeStr          String?     @default("09:00 - 16:00")
  type             String
  typeCategory     String      @default("ภายนอก")
  hours            Int
  approvedHours    Int?
  approvedCategory String?
  status           String      @default("PENDING_APPROVAL")
  statusText       String      @default("รอตรวจสอบ")
  imageProof       String?
  note             String?
  rejectReason     String?
  createdAt        DateTime    @default(now())
  UserProfile      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Approval {
  id                String           @id
  submissionId      String
  decision          ApprovalDecision
  reason            String?
  decidedByUsername String
  decidedAt         DateTime         @default(now())
  HourSubmission    HourSubmission   @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

model CoOpRequirement {
  id            String   @id
  label         String
  requiredHours Int      @default(15)
  academicYear  String?
  curriculum    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Evidence {
  id                 String         @id
  submissionId       String
  fileName           String
  mimeType           String
  fileSizeBytes      Int
  storagePath        String
  uploadedByUsername String
  uploadedAt         DateTime       @default(now())
  HourSubmission     HourSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

model HourLedger {
  id              String           @id
  studentUsername String
  submissionId    String
  hours           Int
  status          SubmissionStatus
  createdAt       DateTime         @default(now())
  HourSubmission  HourSubmission   @relation(fields: [submissionId], references: [id])

  @@index([studentUsername])
}

model HourSubmission {
  id                 String           @id
  studentUsername    String
  source             SubmissionSource
  activityId         String?
  externalTitle      String?
  externalDate       DateTime?
  hoursRequested     Int
  status             SubmissionStatus @default(SUBMITTED)
  rejectionReason    String?
  reviewedByUsername String?
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  Approval           Approval[]
  Evidence           Evidence[]
  HourLedger         HourLedger[]

  @@index([status])
  @@index([studentUsername])
}

model Participation {
  id              String    @id
  activityId      String
  studentUsername String
  registeredAt    DateTime  @default(now())
  cancelledAt     DateTime?
  Activity        Activity  @relation(fields: [activityId], references: [id])

  @@unique([activityId, studentUsername])
  @@index([studentUsername])
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  NEED_REVISION
}

enum SubmissionSource {
  INTERNAL_ACTIVITY
  EXTERNAL_ACTIVITY
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEED_REVISION
  APPROVED
  REJECTED
  CANCELLED
}
