generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id                   String          @id @default(cuid())
  title                String
  description          String
  location             String          @default("")
  activityType         String          @default("GENERAL") @map("activity_type")
  date                 DateTime        @default(now())
  startTime            DateTime        @default(now()) @map("start_time")
  endTime              DateTime        @default(now()) @map("end_time")
  registrationOpen     DateTime        @default(now()) @map("registration_open")
  registrationClose    DateTime        @default(now()) @map("registration_close")
  registrationDeadline DateTime        @default(now()) @map("registration_deadline")
  capacity             Int             @default(50)
  hours                Float           @default(0)
  lecturerInCharge     String          @default("") @map("lecturer_in_charge")
  coopHours            Float           @default(0) @map("coop_hours")
  volunteerHours       Float           @default(0) @map("volunteer_hours")
  majorHours           Float           @default(0) @map("major_hours")
  status               ActivityStatus  @default(OPEN)
  createdByUsername    String          @default("admin") @map("created_by_username")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  registrations        Registration[]
  participations       Participation[]

  @@index([startTime])
  @@index([status])
  @@map("activities")
}

model HourRequest {
  id               String              @id @default(cuid())
  coreUserId       String?             @map("core_user_id")
  studentId        String              @default("") @map("student_id")
  studentName      String              @default("") @map("student_name")
  title            String
  category         HourRequestCategory @default(COOP)
  hours            Float               @default(0)
  proofUrl         String?             @map("proof_url")
  studentPhoto     String?             @map("student_photo")
  description      String?
  status           HourRequestStatus   @default(PENDING)
  statusText       String?             @map("status_text")
  rejectionReason  String?             @map("rejection_reason")
  rejectReason     String?             @map("reject_reason")
  reviewedBy       String?             @map("reviewed_by")
  dateStr          String?             @map("date_str")
  timeStr          String?             @map("time_str")
  type             String?             @default("กิจกรรมภายนอก")
  typeCategory     String?             @default("ภายนอก") @map("type_category")
  approvedHours    Float?              @map("approved_hours")
  approvedCategory String?             @map("approved_category")
  imageProof       String?             @map("image_proof")
  note             String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  userProfile      UserProfile?        @relation(fields: [coreUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([studentId])
  @@map("hour_requests")
}

model Registration {
  id                     String             @id @default(cuid())
  activityId             String             @map("activity_id")
  username               String
  status                 RegistrationStatus @default(REGISTERED)
  queueNumber            Int?               @map("queue_number")
  registeredAt           DateTime           @default(now()) @map("registered_at")
  attendedAt             DateTime?          @map("attended_at")
  cancelledAt            DateTime?          @map("cancelled_at")
  creditedCoopHours      Float?             @map("credited_coop_hours")
  creditedVolunteerHours Float?             @map("credited_volunteer_hours")
  creditedMajorHours     Float?             @map("credited_major_hours")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  activity               Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userProfile            UserProfile        @relation(fields: [username], references: [username], onDelete: Restrict)

  @@unique([activityId, queueNumber])
  @@unique([activityId, username])
  @@index([status])
  @@map("registrations")
}

model Participation {
  id              String    @id @default(cuid())
  activityId      String    @map("activity_id")
  studentUsername String    @map("student_username")
  registeredAt    DateTime  @default(now()) @map("registered_at")
  cancelledAt     DateTime? @map("cancelled_at")

  activity        Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentUsername])
  @@index([studentUsername])
  @@map("participations")
}

model UserHourSummary {
  id             String      @id @default(cuid())
  username       String      @unique
  coopHours      Float       @default(0) @map("coop_hours")
  volunteerHours Float       @default(0) @map("volunteer_hours")
  majorHours     Float       @default(0) @map("major_hours")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user           UserProfile @relation(fields: [username], references: [username], onDelete: Restrict)

  @@map("user_hour_summaries")
}

model UserProfile {
  id          String           @id @default(cuid())
  username    String           @unique
  studentCode String?          @unique @map("student_code")
  fullName    String?          @map("full_name")
  displayName String?          @map("display_name")
  email       String?          @unique
  faculty     String?          @default("วิทยาศาสตร์")
  major       String?
  yearLevel   Int?             @map("year_level")
  layer2Role  SubsystemRole    @default(student) @map("layer2_role")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  summary      UserHourSummary?
  registers    Registration[]
  hourRequests HourRequest[]

  @@index([layer2Role])
  @@map("user_profiles")
}

enum ActivityStatus {
  OPEN
  PUBLISHED
  CLOSED
  COMPLETED
}

enum HourRequestCategory {
  COOP
  VOLUNTEER
  MAJOR
}

enum HourRequestStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  REGISTERED
  WAITING
  ATTENDED
  ABSENT
  CANCELLED
}

enum SubsystemRole {
  student
  admin
}